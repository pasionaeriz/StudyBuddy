<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#7E57C2"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="45sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDYBUDDY"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your simple study assistant"
                android:textSize="16sp"
                android:textColor="#EDE7F6"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a Feature"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2D2438"
                android:layout_marginBottom="20dp" />

            <!-- GRADE CALCULATOR CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_background"
                android:layout_marginBottom="20dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Grade Calculator"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#512DA8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculate your average grade and check your result."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="15dp" />

                <Button
                    android:id="@+id/btnGradeCalculator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPEN GRADE CALCULATOR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#7E57C2" />

            </LinearLayout>

            <!-- STUDY PLANNER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/card_background"
                android:elevation="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ Study Time Planner"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#512DA8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Divide your available study time between your subjects."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="15dp" />

                <Button
                    android:id="@+id/btnStudyPlanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPEN STUDY PLANNER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#7E57C2" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>