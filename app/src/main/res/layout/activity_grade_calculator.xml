<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRADE CALCULATOR"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#512DA8"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your score and total score for each requirement."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="30dp" />


        <!-- ========================= -->
        <!-- ACTIVITIES -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activities"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/activityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Activity"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7E57C2"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />


        <!-- ========================= -->
        <!-- QUIZZES -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quizzes"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/quizContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Quiz"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7E57C2"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />


        <!-- ========================= -->
        <!-- EXAM -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exam"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etExamScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Score"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginEnd="5dp" />

            <EditText
                android:id="@+id/etExamTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Total Score"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginStart="5dp" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- CALCULATE -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CALCULATE GRADE"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#512DA8"
            android:layout_marginTop="30dp" />


        <!-- ========================= -->
        <!-- RESULT -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your grade result will appear here."
            android:textSize="18sp"
            android:textColor="#000000"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>